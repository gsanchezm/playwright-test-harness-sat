{
  "name": "omnipizza-ia-harness",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven Playwright + TypeScript E2E harness for OmniPizza",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:cross": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit --project=ui-mobile-chrome --project=ui-mobile-safari",
    "test:firefox": "playwright test --project=ui-firefox",
    "test:webkit": "playwright test --project=ui-webkit",
    "test:mobile": "playwright test --project=ui-mobile-chrome --project=ui-mobile-safari",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke --project=ui-chromium",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
